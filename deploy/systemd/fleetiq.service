[Unit]
Description=FLEET-IQ Rapid Transit Control Centre
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fleetiq
Group=fleetiq
WorkingDirectory=/opt/fleetiq
EnvironmentFile=/etc/fleetiq/fleetiq.env
ExecStart=/opt/fleetiq/venv/bin/python /opt/fleetiq/backend/server.py --host 127.0.0.1 --port 5001 --ws-port 8765 --start-mode simulation
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/fleetiq
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fleetiq

[Install]
WantedBy=multi-user.target
