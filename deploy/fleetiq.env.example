# FLEET-IQ production environment (install to /etc/fleetiq/fleetiq.env).
# Same-origin deployment: nginx serves the SPA and proxies the API, so the
# frontend needs no build-time variables and CORS stays off.
#
#   sudo install -m 0640 -o root -g fleetiq fleetiq.env.example /etc/fleetiq/fleetiq.env
#   sudo nano /etc/fleetiq/fleetiq.env

FLEETIQ_ENV=production
FLEETIQ_SAME_ORIGIN=1

# Login for the demo. Change this before the judges arrive.
FLEETIQ_ADMIN_USER=admin
FLEETIQ_ADMIN_PASSWORD=
FLEETIQ_SESSION_TTL_HOURS=12

# Every /api endpoint except /api/health and /api/auth/login needs a token.
# FLEETIQ_REQUIRE_AUTH_READS=1

# SQLite lives on the server's disk, not in the (replaced) source tree.
FLEETIQ_DB=/var/lib/fleetiq/control_centre.db

# No cameras on a server: report the slots as disabled instead of pretending.
FLEETIQ_DRIVER_CAMERA_DEVICE=none
FLEETIQ_CABIN_CAMERA_DEVICE=none
FLEETIQ_ROAD_CAMERA_DEVICE=none
