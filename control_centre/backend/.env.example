# Control Centre backend environment.
# Copy to `.env` and export before starting the server, or set these in your
# host's secret/environment settings. Never commit a filled-in copy.

# --- Exposure -------------------------------------------------------------
# "development" (default) keeps the permissive local posture. "production"
# requires the two values below and refuses to start without them.
FLEETIQ_ENV=development

# Exact frontend origin(s) allowed to call the API, comma-separated.
# Only needed when the frontend is hosted separately from the API. Leave the
# default (same-origin) when nginx serves both from one host: same-origin
# requests need no CORS headers, and none are sent.
# FLEETIQ_SAME_ORIGIN=0
# FLEETIQ_CORS_ORIGINS=https://your-app.vercel.app,https://ops.example.com

# Require a bearer token on every /api endpoint except /api/health and
# /api/auth/login. Defaults to on when FLEETIQ_ENV=production.
# FLEETIQ_REQUIRE_AUTH_READS=1

# Bypass the production startup guard. Only for a deliberate, monitored
# exposure during development.
# FLEETIQ_ALLOW_INSECURE_STARTUP=1

# --- Authentication (REQUIRED in production) ------------------------------
# The development default is admin/admin123 and MUST be replaced.
# FLEETIQ_ADMIN_USER=admin
# FLEETIQ_ADMIN_PASSWORD=
FLEETIQ_SESSION_TTL_HOURS=12

# --- Persistence ----------------------------------------------------------
# Point at a mounted volume on a real host. The default keeps the database
# inside the source tree, which is wiped on every ephemeral deploy.
# FLEETIQ_DB=/var/lib/fleetiq/control_centre.db

# --- Cameras / ML (optional; no cameras on a server means AI stays off) ----
# FLEETIQ_DRIVER_CAMERA_DEVICE=none
# FLEETIQ_CABIN_CAMERA_DEVICE=none
# FLEETIQ_ROAD_CAMERA_DEVICE=none
# FLEETIQ_CAMERA_BUS_ID=PROTO-001
# FLEETIQ_CABIN_MODEL_PATH=
# FLEETIQ_CABIN_INFERENCE_INTERVAL_SEC=2.0
# FLEETIQ_CABIN_DEFAULT_CAPACITY=40
# FLEETIQ_CABIN_CAMERA_ID=CAM-CAB-001
