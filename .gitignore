__pycache__/
*.py[cod]
*.egg-info/
.vscode/
.idea/
node_modules/
dist/
build/

# Runtime state the app writes itself (fresh clones regenerate defaults).
# NOTE: feature_toggles.json must stay untracked — the Features page writes
# live toggle choices into it, and those must never be committed.
control_centre/backend/feature_toggles.json

# Environments
venv/
.venv/
.env
.env.local
.env.*.local

# Logs & session data
bus_node/logs/
data/logs/
*.csv
session_summary_*.txt

# Models (large binaries; re-downloadable)
bus_node/models/face_landmarker.task
# NOTE: bus_node/src/yolov8n.pt is intentionally TRACKED — the cabin person
# detector resolves it as its in-repo default and tests assert it exists, so a
# fresh clone must contain it.

# Runtime databases
*.db
*.db-shm
*.db-wal

# Agent / editor tooling (local only, never published)
.codex/
.opencode/
.claude/
.cursor/
.session-recall/

# Graphify knowledge graph — local tooling output only, never uploaded.
# The graph still works locally; it is simply not part of the repository.
graphify-out/
.graphifyignore

# Rendered video / brag output (regenerable media)
brag-output-*/
generated_audio/

# Large local-only documents and raw datasets (kept on disk, never pushed).
# The app loads control_centre/backend/data/mtc-gtfs.zip, not these copies.
patent/
SIH PPTX/
data/Chennai_MTC_QGIS_Project/

# OS
.DS_Store
Thumbs.db
# MediaPipe model (3.6MB, re-downloadable)
control_centre/backend/models/*.task
